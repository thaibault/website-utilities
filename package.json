{
  "name": "website-utilities",
  "version": "1.0.474",
  "description": "extend your web app",
  "keywords": [
    "website",
    "utilities"
  ],
  "homepage": "https://tsickert.com/website-utilities",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/website-utilities/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/website-utilities"
  },
  "type": "module",
  "bin": "deploy.js",
  "files": [
    "deploy.d.ts",
    "deploy.js",
    "fonts.compiled.css",
    "fonts.scss",
    "index.compiled.css",
    "index.d.ts",
    "index.js",
    "index.scss",
    "fonts",
    "fonts.compiled",
    "type.d.ts",
    "_variables.scss"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types && yarn build:deploy && yarn build:web",
    "build:bundle": "yarn build:types && yarn build:deploy && yarn build:bundle:web",
    "build:bundle:web": "weboptimizer build '{__reference__: \"target:bundle\"}'",
    "build:deploy": "weboptimizer build '{__reference__: \"target:deploy\"}'",
    "build:types": "weboptimizer build:types",
    "build:web": "weboptimizer build",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "deploy": "./deploy.js",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "weboptimizer test",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-transform-proto-to-assign": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "bootstrap-icons": "^1.13.2",
    "clientnode": "^4.0.1524",
    "css-loader": "^7.1.5",
    "cssnano": "^9.9.0",
    "eslint": "^10.13.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.2",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.32",
    "postcss-fontpath": "^1.0.0",
    "postcss-import": "^17.0.1",
    "postcss-loader": "^8.2.1",
    "postcss-preset-env": "^11.6.1",
    "postcss-scss": "^4.0.9",
    "postcss-sprites": "^4.2.1",
    "postcss-url": "^10.1.4",
    "prop-types": "^15.8.1",
    "sass": "^1.106.1",
    "sass-loader": "^17.0.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.72.1",
    "web-component-wrapper": "^0.0.619",
    "web-documentation": "^1.0.65",
    "weboptimizer": "^4.0.91",
    "webpack-dev-server": "^6.1.0"
  },
  "peerDependencies": {
    "bootstrap-icons": "*",
    "clientnode": "*",
    "web-component-wrapper": "*"
  },
  "peerDependenciesMeta": {
    "bootstrap-icons": {
      "optional": true
    }
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "deDE",
      "enUS",
      "frFR"
    ],
    "tagline": "extend your web app<!--deDE:erweitere deine Webanwendung-->",
    "trackingCode": "UA-40192634-5"
  },
  "webOptimizer": {
    "commandLine": {
      "lint": {
        "__append__": {
          "arguments": [
            {
              "__evaluate__": "path.resolve(self.path.source.asset.cascadingStyleSheet, '**/*.scss')"
            },
            "--config",
            {
              "__evaluate__": "path.relative(self.path.context, path.resolve(webOptimizerPath, 'stylelintConfigurator.js'))"
            }
          ],
          "command": "stylelint",
          "indicator": "self.needed.cascadingStyleSheet"
        },
        "__remove__": "__0__"
      },
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "generic": {
      "supportedBrowsers": [
        "browserslist config and supports es6-class"
      ]
    },
    "injection": {
      "autoExclude": {
        "paths": {
          "__append__": "./deploy.ts"
        }
      },
      "chunks": false,
      "entry": {
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test'} : {fonts: './fonts.scss', index: ['./index.scss', './index.ts']}"
      }
    },
    "module": {
      "cascadingStyleSheet": {
        "options": {
          "esModule": true
        }
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "htmlMinifier": {
          "ignoreCustomComments": [
            {
              "__evaluate__": "/^\\|?[a-z]{2}[A-Z]{2}:/"
            },
            {
              "__evaluate__": "/^[a-z]{2}[A-Z]{2}$/"
            }
          ]
        }
      },
      "preprocessor": {
        "cascadingStyleSheet": {
          "additional": {
            "post": [
              "{loader: 'sass-loader'}"
            ]
          }
        }
      }
    },
    "path": {
      "source": {
        "asset": {
          "font": "fonts/"
        }
      },
      "target": {
        "asset": {
          "font": "fonts.compiled/"
        }
      }
    },
    "stylelint": {
      "plugins": [
        "stylelint-scss"
      ],
      "#:annotation-no-unknown": "Avoids issues about unknown \"!default\" annotation in variable assignment statements.",
      "#:rules:at-rule-descriptor-no-unknown": "Avoid findings about unknown \"font-path\" descriptors in \"@font-face\".",
      "#:at-rule-no-unknown": "Avoid findings about unknown \"@-rules\" like \"@use\".",
      "rules": {
        "annotation-no-unknown": null,
        "at-rule-descriptor-no-unknown": null,
        "at-rule-no-unknown": null
      }
    },
    "target:bundle": {
      "inPlace": {
        "externalLibrary": {
          "dynamic": true,
          "normal": true
        }
      }
    },
    "target:deploy": {
      "assetPattern": {
        "javaScript": {
          "pattern": {
            "#": "This is how we can make our artefact executable.",
            "__evaluate__": "`#!/usr/bin/env node\n// -*- coding: utf-8 -*-\n{1}`"
          }
        }
      },
      "generic": {
        "isWeb": false
      },
      "injection": {
        "entry": {
          "__evaluate__": "{deploy: './deploy'}"
        }
      },
      "module": {
        "optimizer": {
          "terser": {
            "terserOptions": {
              "compress": {
                "#": "To provide a logging output we need to exclude this feature.",
                "drop_console": {
                  "__evaluate__": "false"
                },
                "drop_debugger": {
                  "__evaluate__": "false"
                }
              }
            }
          }
        }
      },
      "targetTechnology": {
        "boilerplate": "node",
        "payload": "node"
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
